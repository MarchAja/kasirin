# Port layanan lokal (boleh diubah)
PORT=3000

# Kata sandi pemilik untuk mengakses panel pemilik
KASIRIN_OWNER_PASSWORD=owner123

# PIN kasir (4-6 angka) untuk membuka sesi kasir
KASIRIN_KASIR_PIN=123456

# PIN pemilik (4-8 angka) untuk memberi diskon; berbeda dengan kata sandi
KASIRIN_OWNER_PIN=246810

# Folder penyimpanan data SQLite, foto, dan cadangan
KASIRIN_DATA_DIR=./data

# Aktifkan mode demo berisi menu contoh (1 = aktif, 0 = mati)
KASIRIN_DEMO=1

# Token autentikasi ngrok untuk akses pelanggan lewat tunnel (kosongkan jika tidak dipakai)
NGROK_AUTHTOKEN=

# Kunci Midtrans untuk pembayaran QRIS otomatis
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_CLIENT_KEY=
