{
  "name": "kasirin",
  "version": "0.1.0",
  "private": true,
  "description": "POS open source untuk UMKM F&B Indonesia — jalan di komputer kasir sendiri, tanpa VPS.",
  "license": "AGPL-3.0-only",
  "author": "MarchAja (https://github.com/MarchAja)",
  "homepage": "https://github.com/MarchAja/kasirin",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev -w @kasirin/server\" \"npm:dev -w @kasirin/web\"",
    "start": "npm run start -w @kasirin/server",
    "start:prod": "npm run start:prod -w @kasirin/server",
    "build": "npm run build -w @kasirin/server && npm run build -w @kasirin/web",
    "typecheck": "npm run typecheck -w @kasirin/server && npm run typecheck -w @kasirin/web",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "npm run db:migrate -w @kasirin/server",
    "db:seed": "npm run db:seed -w @kasirin/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
